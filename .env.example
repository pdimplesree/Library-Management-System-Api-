# ==========================================================
# Aditya University Smart Library - Environment Configuration
# Copy this file to .env and configure your credentials
# ==========================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aditya_smart_library
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication Secret (set a unique random value of at least 32 characters)
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_EXPIRATION_HOURS=24

# Demo Configuration
TOTAL_LIBRARY_CAPACITY=150
TOTAL_LIBRARY_SEATS=50
DEMO_MODE=true
